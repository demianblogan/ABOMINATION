# Normalize line endings: LF in the repository, native on checkout.
* text=auto

# Source and text files
*.cpp     text diff=cpp
*.hpp     text diff=cpp
*.h       text diff=cpp
*.glsl    text
*.vert    text
*.frag    text
*.json    text
*.md      text diff=markdown
*.txt     text
*.cmake   text
*.map     text

# Windows-only scripts must keep CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf
*.sln     text eol=crlf

# Binary assets — never touch line endings, never diff
*.png     binary
*.jpg     binary
*.tga     binary
*.ktx2    binary
*.glb     binary
*.wav     binary
*.ogg     binary
*.ttf     binary
*.otf     binary
*.ico     binary

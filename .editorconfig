# Editor settings shared by Visual Studio, VS Code and others.
# Line endings are handled by .gitattributes.
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,hpp,h,vert,frag,geom,comp,glsl}]
max_line_length = 127

[*.{json,yml,yaml}]
indent_size = 2

[CMakePresets.json]
indent_size = 2

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[ThirdParty/**]
# Third-party files are kept exactly as they were delivered.
trim_trailing_whitespace = false
insert_final_newline = unset
